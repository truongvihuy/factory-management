{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "paths": {
      "@libs/mqtt": [
        "libs/mqtt"
      ],
      "@libs/mqtt/*": [
        "libs/mqtt/*"
      ],
      "@libs/auth": [
        "libs/auth"
      ],
      "@libs/auth/*": [
        "libs/auth/*"
      ],
      "@libs/common": [
        "libs/common"
      ],
      "@libs/common/*": [
        "libs/common/*"
      ],
      "@libs/database": [
        "libs/database"
      ],
      "@libs/database/*": [
        "libs/database/*"
      ],
      "@libs/events": [
        "libs/events"
      ],
      "@libs/events/*": [
        "libs/events/*"
      ],
      "@libs/redis": [
        "libs/redis"
      ],
      "@libs/redis/*": [
        "libs/redis/*"
      ],
      "@libs/utils": [
        "libs/utils"
      ],
      "@libs/utils/*": [
        "libs/utils/*"
      ],
      "@prisma": [
        "generated/prisma"
      ],
      "@prisma/*": [
        "generated/prisma/*"
      ]
    }
  }
}