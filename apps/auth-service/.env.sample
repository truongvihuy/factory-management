APP_NAME=fms-auth-service
NODE_ENV=development
PORT=3001

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_FAILURE_WINDOWN=1
AUTH_LOCK_DURATION_MINUTES=15

JWT_SECRET=the-secret
JWT_ISSUER=fms-auth-service
JWT_AUDIENCE=fms
JWT_ACCESS_TOKEN_TTL=900

DATABASE_URL=postgresql://fms:fms@localhost:5432/fms_auth

REDIS_URL=redis://localhost:6379

GRPC_HOST=0.0.0.0
GRPC_PORT=5001

RABBITMQ_URL=amqp://guest:guest@localhost:5672