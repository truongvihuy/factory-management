generator client {
  provider = "prisma-client-js"
  }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportType {
  MACHINE_STATUS
  MAINTENANCE
  INCIDENT
  ENERGY
  KPI
}

model ReportDefinition {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(255)
  type        ReportType
  description String? @db.Text
  active      Boolean @default(true)
  createdBy   String @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, active])
}

model KpiSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  factoryId   String   @db.Uuid
  metric      String   @db.VarChar(100)
  value       Decimal  @db.Decimal(20, 6)
  unit        String?  @db.VarChar(50)
  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)
  generatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([factoryId, metric, periodStart, periodEnd])
  @@index([factoryId, periodStart])
}

model MachineStatusSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  factoryId   String   @db.Uuid
  machineId   String   @db.Uuid
  status      String   @db.VarChar(50)
  capturedAt  DateTime @db.Timestamptz(6)

  @@index([factoryId, capturedAt])
  @@index([machineId, capturedAt])
}

model MaintenanceKpiSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  factoryId      String   @db.Uuid
  totalWorkOrders Int
  completedWorkOrders Int
  overdueWorkOrders Int
  totalCost       Decimal? @db.Decimal(20, 2)
  periodStart     DateTime @db.Timestamptz(6)
  periodEnd       DateTime @db.Timestamptz(6)
  generatedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([factoryId, periodStart, periodEnd])
}

model IncidentKpiSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  factoryId       String   @db.Uuid
  totalIncidents  Int
  openIncidents   Int
  criticalIncidents Int
  resolvedIncidents Int
  periodStart     DateTime @db.Timestamptz(6)
  periodEnd       DateTime @db.Timestamptz(6)
  generatedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([factoryId, periodStart, periodEnd])
}

model EnergyKpiSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  factoryId   String   @db.Uuid
  energy      Decimal  @db.Decimal(20, 6)
  unit        String   @db.VarChar(20)
  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)
  generatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([factoryId, periodStart, periodEnd])
  @@index([factoryId, periodStart])
}
