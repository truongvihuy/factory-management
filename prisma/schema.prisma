// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// Auth Service

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  admin     Boolean  @default(false)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())

  userRole UserRole[]
  sessions Session[]
}

model UserRole {
  userId    String
  role      Role
  factoryId String

  user User @relation(fields: [userId], references: [id])

  @@id([userId, factoryId])
}

enum Role {
  MANAGER
  ENGINEER
  OPERATOR
  VIEW
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  ip        String
  userAgent String
  revokedAt DateTime?
  expiredAt DateTime?
  createdAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String   @unique
  tokenHash String
  expiredAt DateTime
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])
}

// Factory Service

model Factory {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())

  workshops Workshop[]
}

model Workshop {
  id        String   @id @default(uuid())
  factoryId String
  name      String
  createdAt DateTime @default(now())

  factory  Factory   @relation(fields: [factoryId], references: [id])
  machines Machine[]
}

model Machine {
  id          String         @id @default(uuid())
  workshopId  String
  name        String
  status      Status_Machine
  infoMachine String
  installDate DateTime
  createdAt   DateTime       @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id])
  sensors  Sensor[]
}

enum Status_Machine {
  // Operational Status
  RUNNING
  IDLE
  READY

  // Downtime & Error Status
  DOWN
  ERROR

  // Maintenance & Repair
  MAINTENANCE
  REPAIR
  MATERIAL_SHORTAGE
  SETUP
}

model Sensor {
  id        String        @id @default(uuid())
  machineId String
  name      String
  metric    String
  unit      String
  status    Status_Sensor
  createdAt DateTime      @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
}

enum Status_Sensor {
  ACTIVE
  INACTIVE
  CONNECTED
  DISCONNECTED
}

// Telemetry Service

model Telemetry {
  id         String   @id @default(uuid())
  sensorId   String
  value      Float
  recordedAt DateTime @default(now())
}

enum Severity {
  LOW
  MEDIUM
  HIGHT
  CRITICAL
}
