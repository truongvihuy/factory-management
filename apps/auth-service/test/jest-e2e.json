{
  "displayName": "fms-auth-service-e2e",
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": "test/e2e/.*\\.e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "modulePathIgnorePatterns": ["<rootDir>/dist", "<rootDir>/coverage"],
  "clearMocks": true,
  "restoreMocks": true,
  "testTimeout": 30000
}
