{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "composite": true,
    "types": [
      "node"
    ],
    "paths": {
      "@common/*": [
        "libs/common/src/*"
      ],
      "@database/*": [
        "libs/database/src/*"
      ],
      "@auth/*": [
        "libs/auth/src/*"
      ],
      "@events/*": [
        "libs/events/src/*"
      ],
      "@mqtt/*": [
        "libs/mqtt/src/*"
      ],
      "@redis/*": [
        "libs/redis/src/*"
      ]
    }
  },
}