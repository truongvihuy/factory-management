generator client {
  provider = "prisma-client-js"
  }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MajorIncident {
  id          String @id @default(uuid()) @db.Uuid
  factoryId   String @db.Uuid
  title       String @db.VarChar(255)
  description String? @db.Text
  status      IncidentStatus @default(OPEN)
  createdBy   String @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incidents MajorIncidentIncident[]

  @@index([factoryId, status])
}

model Incident {
  id             String @id @default(uuid()) @db.Uuid
  factoryId      String @db.Uuid
  machineId      String @db.Uuid
  alertId        String? @db.Uuid
  majorIncidentId String? @db.Uuid
  title          String @db.VarChar(255)
  description    String? @db.Text
  priority       IncidentPriority
  status         IncidentStatus @default(OPEN)
  openedAt       DateTime @default(now())
  responseDueAt  DateTime?
  resolvedAt     DateTime?
  verifiedAt     DateTime?
  closedAt       DateTime?
  createdBy      String @db.Uuid
  updatedAt      DateTime @updatedAt

  majorIncident MajorIncident? @relation(fields: [majorIncidentId], references: [id])
  assignments IncidentAssignment[]
  statusHistory IncidentStatusHistory[]

  @@index([factoryId, status])
  @@index([machineId, openedAt])
  @@index([priority, status])
  @@index([majorIncidentId])
}

model MajorIncidentIncident {
  majorIncidentId String @db.Uuid
  incidentId      String @db.Uuid
  linkedAt        DateTime @default(now())
  linkedBy        String? @db.Uuid

  majorIncident MajorIncident @relation(fields: [majorIncidentId], references: [id], onDelete: Cascade)
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([majorIncidentId, incidentId])
}

model IncidentAssignment {
  id         String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  userId     String @db.Uuid
  assignedAt DateTime @default(now())
  unassignedAt DateTime?
  assignedBy String? @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, assignedAt])
  @@index([userId, assignedAt])
}

model IncidentStatusHistory {
  id         String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  changedBy  String @db.Uuid
  reason     String? @db.Text
  changedAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, changedAt])
}
